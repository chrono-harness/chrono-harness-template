name: Harness check
on:
  push:
    branches: [{{ dev_branch | to_json }}, main]
  pull_request:
    branches: [{{ dev_branch | to_json }}, main]
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          persist-credentials: false
      - uses: jdx/mise-action@924e7c586e33d7d4bae9c14e26c5d22e2beb6e78
        with:
          version: 2026.11.12
          cache: false
      - run: mise run harness-check
